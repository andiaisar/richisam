# Server Configuration
PORT=5000
NODE_ENV=production

# Supabase / Cloud PostgreSQL (Rekomendasi untuk Deployment)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DB_SSL=true

# Local PostgreSQL Database Configuration (Jika lokal)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=db_richisam

# JWT Authentication Secret
JWT_SECRET=ganti_dengan_secret_key_panjang_dan_aman

# Frontend CORS Origin
FRONTEND_URL=http://localhost:5173

